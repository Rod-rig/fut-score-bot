generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int          @id
  firstName   String
  lastName    String?
  username    String
  result      Float        @default(0)
  createdAt   DateTime     @default(now())
  role        Role         @default(USER)
  predictions Prediction[]
}

model Prediction {
  id        Int      @id @default(autoincrement())
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  event     Event    @relation(fields: [eventId], references: [id])
  eventId   Int

  @@unique([userId, eventId])
}

model Event {
  id          Int          @id
  startDate   DateTime     @db.Date
  startTime   DateTime     @db.Time()
  tournament  String
  home        String
  away        String
  score       String?
  country     String
  flagHome    String
  flagAway    String
  status      EventStatus  @default(FINISHED)
  predictions Prediction[]
  odd         Odd?
}

model Odd {
  id        Int    @id @default(autoincrement())
  one       Float  @map("1")
  x         Float  @map("X")
  two       Float  @map("2")
  zeroZero  Float  @map("0:0")
  oneOne    Float  @map("1:1")
  twoTwo    Float  @map("2:2")
  oneZero   Float  @map("1:0")
  twoZero   Float  @map("2:0")
  threeZero Float  @map("3:0")
  twoOne    Float  @map("2:1")
  threeOne  Float  @map("3:1")
  threeTwo  Float  @map("3:2")
  zeroOne   Float  @map("0:1")
  zeroTwo   Float  @map("0:2")
  zeroThree Float  @map("0:3")
  oneTwo    Float  @map("1:2")
  oneThree  Float  @map("1:3")
  twoThree  Float  @map("2:3")
  anyOther  Float  @map("Any other")
  event     Event? @relation(fields: [eventId], references: [id])
  eventId   Int    @unique
}

enum Role {
  USER
  ADMIN
}

enum EventStatus {
  NOT_STARTED
  FINISHED
}
