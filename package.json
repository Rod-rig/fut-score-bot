{
  "name": "fut-score-bot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start_bot": "nodemon src/index.js",
    "db": "npx prisma studio",
    "migrate": "prisma migrate dev --name init",
    "start:site": "vite",
    "start:bot": "node ./src/bot/index.js",
    "build": "npm i && vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "prettier:write": "npx prettier . --write",
    "prettier:check": "npx prettier . --check",
    "next:dev": "next dev",
    "next:build": "next build",
    "next:start": "next start",
    "next:lint": "next lint",
    "start": "npm run next:start & npm run start:bot"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "description": "Make football predictions",
  "main": "index.js",
  "author": "",
  "type": "module",
  "license": "ISC",
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "lucide-react": "^1.52.0",
    "next": "^16.4.0",
    "next-auth": "^4.24.15",
    "node-fetch": "^3.3.2",
    "node-telegram-bot-api": "^0.63.0",
    "nodemon": "^3.1.4",
    "postcss": "^8.5.3",
    "radix-ui": "^1.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^6.30.6",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "~26.6.4",
    "@types/react": "^19.1.0",
    "prettier": "3.9.9",
    "prisma": "^6.19.2",
    "typescript": "^7.0.2",
    "vite": "^5.4.5"
  }
}
